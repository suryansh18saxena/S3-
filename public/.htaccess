# S3 Infrastructure — static site rules for Apache / LiteSpeed (e.g. Hostinger).
# Generated by scripts/redirects.mjs — edit that file, not this one.

Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Always use HTTPS and the bare domain.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://s3infrastructure.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Legacy WordPress URLs (permanent).
<IfModule mod_alias.c>
  RedirectMatch 301 ^/contact-2/?$ /contact/
  RedirectMatch 301 ^/contact-us/?$ /contact/
  RedirectMatch 301 ^/architecture/?$ /architectural/
  RedirectMatch 301 ^/turnkeyconstruction/?$ /turnkey-construction/
  RedirectMatch 301 ^/renovation-2/?$ /renovation/
  RedirectMatch 301 ^/about/?$ /about-us/
  RedirectMatch 301 ^/portfolio/?$ /projects/
  RedirectMatch 301 ^/services-1/?$ /services/
  RedirectMatch 301 ^/service-01/?$ /services/
  RedirectMatch 301 ^/service-02/?$ /services/
  RedirectMatch 301 ^/services-details/?$ /services/
  RedirectMatch 301 ^/price-plan/?$ /turnkey-construction/
  RedirectMatch 301 ^/get-quote/?$ /contact/
  RedirectMatch 301 ^/blogs/?$ /
  RedirectMatch 301 ^/blog/?$ /
  RedirectMatch 301 ^/blog-list/?$ /
  RedirectMatch 301 ^/blog-standard/?$ /
  RedirectMatch 301 ^/best-architects-near-me/?$ /architectural/
  RedirectMatch 301 ^/architects-in-chennai/?$ /architectural/
  RedirectMatch 301 ^/residential-architects-in-chennai/?$ /architectural/
  RedirectMatch 301 ^/modern-architectural-design-ideas/?$ /architectural/
  RedirectMatch 301 ^/trusted-home-construction-company-chennai/?$ /turnkey-construction/
  RedirectMatch 301 ^/house-construction-in-chennai/?$ /turnkey-construction/
  RedirectMatch 301 ^/building-contractors-in-chennai/?$ /turnkey-construction/
  RedirectMatch 301 ^/builders-in-chennai/?$ /turnkey-construction/
  RedirectMatch 301 ^/civil-engineers-for-home-construction/?$ /structural-engineer/
  RedirectMatch 301 ^/top-structural-engineer-in-chennai/?$ /structural-engineer/
  RedirectMatch 301 ^/top-interior-designers-in-chennai/?$ /interior-design/
  RedirectMatch 301 ^/interior-designers-in-chennai/?$ /interior-design/
  RedirectMatch 301 ^/interior-decorators-for-homes/?$ /interior-design/
  RedirectMatch 301 ^/who-are-the-top-interior-designers-in-chennai-for-home-makeovers/?$ /interior-design/
  RedirectMatch 301 ^/house-renovation-services-near-you/?$ /renovation/
  RedirectMatch 301 ^/best-home-renovators-in-chennai/?$ /renovation/
  RedirectMatch 301 ^/affordable-home-renovation-experts/?$ /renovation/
  RedirectMatch 301 ^/demolition-contractors-in-chennai/?$ /services/
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Fingerprinted build assets never change.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Images and fonts: long cache, revalidate monthly.
  <If "%{REQUEST_URI} =~ m#^/(media|brand)/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>
